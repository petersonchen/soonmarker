{
  "manifest_version": 3,
  "name": "soonmarker",
  "version": "0.3.0",
  "description": "為 YouTube、臺北市議會與立法院 IVOD 影片建立時間標記，快速定位播放，並依 Episode 整理片段。",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://live.tcc.gov.tw/*", "https://www.youtube.com/*", "https://ivod.ly.gov.tw/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-marker": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Save a marker at the current video time"
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_title": "soonmarker",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["https://live.tcc.gov.tw/*", "https://www.youtube.com/*", "https://ivod.ly.gov.tw/*"],
    "js": ["lib/timecode.js", "lib/video-key.js", "content/video-controller.js"],
    "run_at": "document_idle"
  }]
}
